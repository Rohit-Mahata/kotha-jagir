# ─── Environment & Secrets ────────────────────────────────────────────────────
# CRITICAL: Never commit real credentials to version control
.env
.env.local
.env.*.local
.env.production
.env.staging

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Build Outputs ────────────────────────────────────────────────────────────
dist/
build/
client/dist/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Editor & IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Temporary / Upload Files ─────────────────────────────────────────────────
tmp/
temp/
uploads/

# ─── Large Installer Binaries (already in repo root, exclude from git) ────────
*.msi
*.exe
*.dmg
